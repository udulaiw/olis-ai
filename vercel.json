{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "dist",
  "functions": {
    "api/agent.ts": { "maxDuration": 60, "includeFiles": "server/generated/**" },
    "api/generate.ts": { "maxDuration": 45, "includeFiles": "server/generated/**" },
    "api/health.ts": { "includeFiles": "server/generated/**" },
    "api/feedback.ts": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
