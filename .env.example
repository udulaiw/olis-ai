# ─────────────────────────────────────────────────────────────
#  OLIS AI · server environment variables
#
#  On Vercel: Project → Settings → Environment Variables (NOT in code).
#  Locally:   copy this file to .env.local (git-ignored).
#
#  None of these are ever sent to the browser. Without GEMINI_API_KEY
#  the app still works in offline Demo mode.
# ─────────────────────────────────────────────────────────────

# REQUIRED for OLIS Cloud. Free, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Chat model (Flash-Lite = fastest + most generous free limits)
GEMINI_MODEL=gemini-3.5-flash-lite
# Embedding model for the RAG knowledge base (semantic search)
GEMINI_EMBED_MODEL=gemini-embedding-001

# OPTIONAL: live web search via Tavily (free tier, no card): https://tavily.com
# Without it, OLIS still researches with its knowledge base + Wikipedia.
TAVILY_API_KEY=
# "trusted" = only educational domains (recommended) · "open" = whole web
WEB_SEARCH_SCOPE=trusted
# Override the trusted domain list (comma-separated), optional
TRUSTED_DOMAINS=

# OPTIONAL: forward 👍/👎 feedback somewhere permanent (Google Sheets Apps
# Script URL, Discord webhook…). Otherwise it's in Vercel → Logs.
FEEDBACK_WEBHOOK_URL=

# OPTIONAL: safety limits
RATE_LIMIT_PER_10MIN=30
AGENT_MAX_STEPS=4
# Extra origins allowed to call the API (comma-separated). Default: same site only.
ALLOWED_ORIGINS=
