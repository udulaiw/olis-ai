# ─────────────────────────────────────────────────────────────
#  OLIS AI · server environment variables
#
#  On Vercel: Project → Settings → Environment Variables (NOT in code).
#  Locally:   copy this file to .env.local (git-ignored).
#
#  None of these ever reach the browser (only VITE_* vars would, and OLIS
#  uses none). Without any provider key, OLIS runs in offline Demo mode.
# ─────────────────────────────────────────────────────────────

# ── Cost safety ──────────────────────────────────────────────
# Free Beta: only approved free-tier models can be called; paid/unknown models
# are blocked. ON unless this is exactly "false".
OLIS_FREE_BETA=true
# Explicitly approve extra free models (provider:model, comma-separated), optional
OLIS_FREE_BETA_EXTRA_MODELS=

# ── AI providers (at least one) ──────────────────────────────
# Google Gemini: PRIMARY. Free, no card: https://aistudio.google.com/apikey
# ⚠ Use a key from a project WITHOUT billing enabled. With billing on, Google
#   bills even "free" models, and OLIS can't detect that.
GEMINI_API_KEY=
# Model overrides (optional; must be on the Free Beta allowlist in server/ai/models.config.ts)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REASONING_MODEL=gemini-3.5-flash
GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
# Embedding model for knowledge-base semantic search
GEMINI_EMBED_MODEL=gemini-embedding-001

# NVIDIA API catalog: OPTIONAL fallback. https://build.nvidia.com
# ⚠ NVIDIA's free endpoints are licensed for development / testing / evaluation,
#   not production. Read their terms before enabling this on a public deployment.
NVIDIA_API_KEY=
NVIDIA_REASONING_MODEL=
NVIDIA_FAST_MODEL=
NVIDIA_NEMOTRON_MODEL=
NVIDIA_VISION_MODEL=

# ── More free official providers (all OPTIONAL; each turns on when its key is set) ──
# Fallbacks behind Gemini, tried in this order. Free tiers, no card. Source list:
# github.com/open-free-llm-api/awesome-freellm-apis (checked against each provider's docs, Oct 2026).
# Groq: https://console.groq.com/keys  (free plan; per-model RPM/RPD limits)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REASONING_MODEL=openai/gpt-oss-120b
# Cerebras: https://cloud.cerebras.ai  (free tier, 64k context)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# Mistral: https://console.mistral.ai  (free "Experiment" plan; ⚠ free-plan data may be used for training unless you opt out)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# OpenRouter: https://openrouter.ai/keys  (only free models are allowed: 20 req/min, 50 req/day without credits)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Open-source model server: OPTIONAL. Any OpenAI-compatible host: Ollama (http://localhost:11434/v1 for `npm run dev`),
# Ollama Cloud (https://ollama.com/v1 + LOCAL_AI_API_KEY), vLLM, LM Studio, a Hugging Face endpoint…
# On Vercel it must be reachable from the internet.
LOCAL_AI_BASE_URL=
LOCAL_AI_API_KEY=
LOCAL_AI_MODEL=llama3.2

# ── Retrieval: optional open-source models on YOUR server (not on Vercel) ──
# Without these, OLIS uses Gemini embeddings (GEMINI_API_KEY) + its built-in reranking signals.
# Cross-encoder reranker, e.g. BAAI/bge-reranker-v2-m3 on Hugging Face text-embeddings-inference (POST /rerank)
RERANKER_URL=
RERANKER_API_KEY=
RERANKER_TIMEOUT_MS=2500
# Embeddings: "gemini" (default) or "tei" (e.g. BAAI/bge-m3 on text-embeddings-inference, POST /embed). Changing this needs a redeploy (rebuilds the index).
EMBED_PROVIDER=gemini
EMBED_URL=
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIMS=1024

# ── Limits & timeouts ────────────────────────────────────────
# Per-student (IP) burst limit and daily limit across AI routes
RATE_LIMIT_PER_10MIN=30
DAILY_REQUEST_LIMIT=150
AGENT_MAX_STEPS=4
# Wait for a model's first output / max silence mid-stream before falling back (ms)
AI_FIRST_CHUNK_TIMEOUT_MS=30000
AI_IDLE_TIMEOUT_MS=20000
# OPTIONAL: share limits across serverless instances (Upstash Redis free tier)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Research tools ───────────────────────────────────────────
# OPTIONAL: live web search via Tavily (free tier, no card): https://tavily.com
TAVILY_API_KEY=
# "trusted" = only educational domains (recommended) · "open" = whole web
WEB_SEARCH_SCOPE=trusted
TRUSTED_DOMAINS=

# ── Open knowledge sources ───────────────────────────────────
# Wikipedia (en/si/ta), Wikidata, arXiv and Crossref need NO keys.
# OPTIONAL: free OpenAlex key raises the research-paper search budget ~10× (https://openalex.org/settings/api)
OPENALEX_API_KEY=
# OPTIONAL: a contact email sent to OpenAlex/Crossref ("polite pool"); not shown to students
OLIS_CONTACT_EMAIL=

# ── Live data (prices, exchange rates, weather, news) ──────────
# Works with NO keys: CoinGecko, open.er-api.com, Open-Meteo and Google News RSS are free and keyless.
# TAVILY_API_KEY above, if set, is also used for "latest X" questions (open web, not limited to TRUSTED_DOMAINS).
# OPTIONAL: CoinGecko demo key (free) only raises crypto rate limits on shared hosting: https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# ── Ops ──────────────────────────────────────────────────────
# Unlocks /api/health?detail=1 and Settings → Developer (tap the version 5×). Use a long random string.
OLIS_ADMIN_TOKEN=
# Set to "off" to silence the per-call AI logs
OLIS_AI_LOGS=
# Forward 👍/👎 feedback somewhere permanent (Google Sheets Apps Script, Discord…)
FEEDBACK_WEBHOOK_URL=
# Extra origins allowed to call the API (comma-separated). Default: same site only.
ALLOWED_ORIGINS=
